# This box's graph: `yak serve` over ~/.yak/yak.json, on the port tasks.yak.sh
# and the `tasks` MCP entry already reach (the config's `port`). This process
# serves web only; independent yak-work@ workers hold duty leases and effects.
# Managed runs leave the launcher's cgroup and survive either host restarting.
# The main checkout's source is live after `yak restart`.

[Unit]
Description=yak web (%i; ~/.yak/yak.json)
After=network-online.target

[Service]
WorkingDirectory=%h/.yak
# The PATH every agent it spawns inherits: ~/.deno/bin carries yak and task,
# Linuxbrew carries deno/git/gh/node, and the provider CLIs resolve here.
Environment=PATH=%h/.deno/bin:%h/.local/bin:%h/bin:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=LANG=C.UTF-8 LC_ALL=C.UTF-8
# One module cache for every process on the box, whatever HOME a probe moves.
Environment=DENO_DIR=%h/.cache/deno
# `--share` lets the replacement `yak restart` starts listen on the same port
# before this one stops, so a restart refuses no request; `--ready` is the
# file it waits on.
ExecStartPre=/usr/bin/rm -f %t/yak-web-%i.ready
ExecStart=%h/.deno/bin/yak serve --no-duties --share --ready %t/yak-web-%i.ready --config %h/.yak/yak.json
ExecStopPost=/usr/bin/rm -f %t/yak-web-%i.ready
Restart=always
RestartSec=2
# Use `yak restart` for a ready-first handover, not a direct unit restart.
# Stop only serve, not the managed processes it spawned. A stopping serve
# closes its sockets and lets requests in flight finish for 10s (its grace),
# then exits; 30s leaves room to close the graph before systemd kills it.
KillMode=process
TimeoutStopSec=30s

[Install]
WantedBy=default.target
DefaultInstance=boot
