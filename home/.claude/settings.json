{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "500000",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  },
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(zig *)",
      "Bash(sed *)",
      "Bash(git *)"
    ],
    "deny": [
      "AskUserQuestion"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__tasks__task_comment",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-comment-size.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-comment-size.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.deno/bin:$PATH\" TASKS_PROVIDER=claude task session context --hook || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.deno/bin:$PATH\" TASKS_PROVIDER=claude task session context --hook || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.deno/bin:$PATH\" TASKS_PROVIDER=claude task-turn || true",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.deno/bin:$PATH\" TASKS_PROVIDER=claude task-turn || true",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"${CLAUDE_PROJECT_DIR}/.claude/hooks/self-clear-stop.sh\" ]; then \"${CLAUDE_PROJECT_DIR}/.claude/hooks/self-clear-stop.sh\"; else cat >/dev/null; fi || true",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.deno/bin:$PATH\" TASKS_PROVIDER=claude task session wrap --hook || true",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/bin/claude-status",
    "padding": 0
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "tasks@tasks-fleet": true,
    "stripe@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "tasks-fleet": {
      "source": {
        "source": "directory",
        "path": "/home/yaks/code/tasks/channels/marketplace"
      }
    }
  },
  "promptSuggestionEnabled": false,
  "askUserQuestionTimeout": "5m",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
