#!/usr/bin/env python3
"""Expire Wrangler CLI logs after seven days, keeping logs still in use."""

import os
import re
import subprocess
import sys
import time
from pathlib import Path


LOG = re.compile(r'wrangler-\d{4}-\d{2}-\d{2}_\d{2}-\d{2}-\d{2}_\d{3}\.log')
AGE = 7 * 24 * 60 * 60


def clean(logs):
    if not logs.exists():
        return
    if logs.is_symlink() or not logs.is_dir():
        raise ValueError(f'not a log directory: {logs}')

    used = subprocess.run(
        ['lsof', '-Q', '-Fn', '+d', str(logs)],
        capture_output=True,
        check=True,
        text=True,
    )
    open_files = {
        line[1:] for line in used.stdout.splitlines() if line.startswith('n')
    }
    before = time.time() - AGE
    with os.scandir(logs) as entries:
        for entry in entries:
            if (LOG.fullmatch(entry.name) and entry.is_file(follow_symlinks=False)
                and entry.path not in open_files and entry.stat().st_mtime < before):
                os.unlink(entry.path)


if __name__ == '__main__':
    clean(Path(sys.argv[1]) if len(sys.argv) > 1 else
          Path.home() / '.config/.wrangler/logs')
