[Unit]
Description=yak mail (%i; ~/.yak/yak.json)
After=network-online.target

[Service]
WorkingDirectory=%h/.yak
# The PATH every agent it spawns inherits: ~/.deno/bin carries yak and task,
# Linuxbrew carries deno/git/gh/node, and the provider CLIs resolve here.
Environment=PATH=%h/.deno/bin:%h/.local/bin:%h/bin:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=LANG=C.UTF-8 LC_ALL=C.UTF-8
# One module cache for every process on the box, whatever HOME a probe moves.
Environment=DENO_DIR=%h/.cache/deno
ExecStartPre=/usr/bin/rm -f %t/yak-mail-%i.ready
ExecStart=%h/.deno/bin/yak work --process yak-mail --config %h/.yak/yak.json --ready %t/yak-mail-%i.ready
ExecStopPost=-/usr/bin/rm -f %t/yak-mail-%i.ready
Restart=on-failure
# A signalled yak drains and returns 143. Classify a deliberate stop as clean,
# but still restart an unexpected signal; systemctl stop suppresses restarts.
SuccessExitStatus=143
RestartForceExitStatus=143
RestartSec=2
# Use `yak restart` for a ready-first handover, not a direct unit restart.
# TERM only the launcher, which forwards it once so the worker drains.
# At the timeout KILL the whole unit, including the runtime child. Managed
# runs live in independent systemd scopes and are not in this cgroup.
KillMode=mixed
TimeoutStopSec=30s
# Signal exits use 143: failure exits restart, explicit systemd stops do not.

[Install]
WantedBy=default.target
DefaultInstance=boot
